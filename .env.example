# Copie para .env e configure localmente. Nunca faça commit das chaves.
TYPESAFE_API_KEY=
JEV_ENABLED=true
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT=8

# Um único modelo generativo adicional, via Messages API nativa.
ANTHROPIC_API_KEY=
HAIKU_MODEL=claude-haiku-5-5
HAIKU_EFFORT=medium
HAIKU_CHAT_EFFORT=low
HAIKU_TIMEOUT=30
SEED_HISTORICO=true
